# Database Configuration Template for Hostel Management System
# INSTRUCTIONS:
# 1. Copy this file and rename it to 'db.properties' in this same directory.
# 2. Replace YOUR_LOCAL_PASSWORD with your actual local MySQL root password.
# 3. Note: 'db.properties' is git-ignored to ensure your password is never committed.

db.url=jdbc:mysql://localhost:3306/hostel_management?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
db.username=root
db.password=YOUR_LOCAL_PASSWORD
